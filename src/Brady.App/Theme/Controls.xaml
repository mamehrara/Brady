<!--
    Brady's controls, ported 1:1 from design/web-reference/bundle.css (.br-btn, .br-chip, .br-toast-close).
    Hover fills cross-fade by opacity rather than animating brushes, so theme swaps stay instant
    and no frozen theme brush is ever animated.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Brady.App.Controls"
                    xmlns:m="clr-namespace:Brady.App.Toasts.Motion">

    <m:CubicBezierEase x:Key="CssEaseOut" X1="0" Y1="0" X2="0.58" Y2="1" />

    <!-- Focus rings: a solid 2px focus-ring outline, offset 2px. As focus visuals they appear for
         keyboard focus only (CSS :focus-visible), never after a mouse click, and never shift layout. -->
    <Style x:Key="ButtonFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" CornerRadius="16" BorderBrush="{DynamicResource FocusRingBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RowFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-6,0" BorderThickness="2" CornerRadius="{StaticResource RadiusSmCorner}"
                            BorderBrush="{DynamicResource FocusRingBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: primary / glass / quiet, md 32px / sm 28px -->
    <Style TargetType="c:BradyButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource LabelFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource LabelFontWeight}" />
        <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
        <Setter Property="HoverBackground" Value="{DynamicResource GlassStrongBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:BradyButton">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PressShift" />
                        </Grid.RenderTransform>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMdCorner}" />
                        <Border x:Name="HoverLayer" Background="{TemplateBinding HoverBackground}"
                                CornerRadius="{StaticResource RadiusMdCorner}" Opacity="0" />
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMdCorner}">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <c:Icon x:Name="Glyph" Glyph="{TemplateBinding Icon}" Width="16" Height="16"
                                        Margin="0,0,6,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Size" Value="Sm">
                            <Setter TargetName="Glyph" Property="Width" Value="14" />
                            <Setter TargetName="Glyph" Property="Height" Value="14" />
                            <Setter TargetName="Glyph" Property="Margin" Value="0,0,5,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16" EasingFunction="{StaticResource CssEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16" EasingFunction="{StaticResource CssEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Primary">
                <Setter Property="Background" Value="{DynamicResource MossBrush}" />
                <Setter Property="HoverBackground" Value="{DynamicResource MossHoverBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource OnMossBrush}" />
            </Trigger>
            <Trigger Property="Variant" Value="Quiet">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HoverBackground" Value="{x:Null}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="Quiet" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            </MultiTrigger>
            <Trigger Property="Size" Value="Sm">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="10,0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Chip: the kind's tone on its -soft tint, icon and word -->
    <Style TargetType="c:Chip">
        <Setter Property="Background" Value="{DynamicResource MossSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MossBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Chip">
                    <Border Height="22" Padding="6,0,8,0" CornerRadius="11" Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Icon Glyph="{TemplateBinding Glyph}" Width="14" Height="14" Margin="0,0,4,0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Label}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource SansFontFamily}" FontSize="{StaticResource CaptionFontSize}"
                                       LineHeight="{StaticResource CaptionLineHeight}" LineStackingStrategy="BlockLineHeight"
                                       Margin="0,-1,0,1" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Move">
                <Setter Property="Background" Value="{DynamicResource BloomSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource BloomBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Eyes">
                <Setter Property="Background" Value="{DynamicResource SkySoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SkyBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Water">
                <Setter Property="Background" Value="{DynamicResource SkySoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SkyBrush}" />
            </Trigger>
            <Trigger Property="Kind" Value="Stretch">
                <Setter Property="Background" Value="{DynamicResource FurSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FurBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Switch row (.br-switch): 12px vertical padding, 40x22 track, 13px thumb sliding 18px.
         The on/off motion is driven from SwitchRow.cs, so the resting state never animates. -->
    <Style TargetType="c:SwitchRow">
        <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SwitchRow">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource HeadlineText}" />
                                <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="0,1,0,1" /><!-- 2px gap plus the caption baseline nudge -->
                            </StackPanel>
                            <Grid Grid.Column="1" Width="40" Height="22" VerticalAlignment="Center">
                                <Border CornerRadius="11" BorderThickness="1.5" BorderBrush="{DynamicResource ControlLineBrush}" />
                                <Border x:Name="OnFill" CornerRadius="11" Background="{DynamicResource MossBrush}" Opacity="0" />
                                <Grid Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4.5,4.5,0,0">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="ThumbShift" />
                                    </Grid.RenderTransform>
                                    <Ellipse Fill="{DynamicResource InkMutedBrush}" />
                                    <Ellipse x:Name="OnThumb" Fill="{DynamicResource OnMossBrush}" Opacity="0" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tray menu: a glass panel (radius-md) of 32px items (radius-sm), applied per item in code. -->
    <Style x:Key="TrayMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="10,6,10,14" Padding="4" CornerRadius="{StaticResource RadiusMdCorner}"
                            Background="{DynamicResource GlassStrongBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <!-- The menu never animates, so a live shadow is fine here. -->
                            <DropShadowEffect Direction="270" ShadowDepth="6" BlurRadius="20" Opacity="0.22" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuItem" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" Height="32" MinWidth="208" Padding="12,0" Background="Transparent"
                            CornerRadius="{StaticResource RadiusSmCorner}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource LineBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuSeparator" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{DynamicResource LineBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toast close: 28px square, radius-sm, 14px close icon -->
    <Style x:Key="ToastCloseButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
        <Setter Property="ToolTip" Value="Dismiss" />
        <Setter Property="ToolTipService.IsEnabled" Value="False" />
        <Setter Property="AutomationProperties.Name" Value="Dismiss" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource RadiusSmCorner}">
                        <c:Icon Glyph="{StaticResource IconClose}" Width="14" Height="14"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource LineBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
