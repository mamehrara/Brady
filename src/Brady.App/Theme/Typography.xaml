<!--
    Brady's type styles, recreated from tokens.json (sizes, line heights and weights come from
    Tokens.Metrics.xaml). Fredoka is the display family, Figtree the sans family; both are
    embedded, with Segoe UI Variable as the fallback so a missing font still looks native.

    Baseline nudges: with BlockLineHeight, WPF sets glyphs 1-2px lower in the line box than CSS's
    half-leading does (measured against the reference screens). Each style shifts its glyphs back up
    with a layout-neutral margin (-n top, +n bottom), so line boxes keep their exact CSS heights.
    Elements that need their own margin add the nudge to it (see ToastView.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="DisplayFontFamily">pack://application:,,,/Brady;component/Fonts/#Fredoka, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="SansFontFamily">pack://application:,,,/Brady;component/Fonts/#Figtree, Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <Style x:Key="DisplayText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource DisplayFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource DisplayLineHeight}" />
        <Setter Property="FontWeight" Value="{StaticResource DisplayFontWeight}" />
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="Margin" Value="0,-1,0,1" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource TitleLineHeight}" />
        <Setter Property="FontWeight" Value="{StaticResource TitleFontWeight}" />
    </Style>

    <Style x:Key="NumeralText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource NumeralFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource NumeralLineHeight}" />
        <Setter Property="FontWeight" Value="{StaticResource NumeralFontWeight}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="HeadlineText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource HeadlineFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource HeadlineLineHeight}" />
        <Setter Property="FontWeight" Value="{StaticResource HeadlineFontWeight}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="Margin" Value="0,-2,0,2" />
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource BodyLineHeight}" />
        <Setter Property="FontWeight" Value="{StaticResource BodyFontWeight}" />
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource LabelFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource LabelLineHeight}" />
        <Setter Property="FontWeight" Value="{StaticResource LabelFontWeight}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="Margin" Value="0,-1,0,1" />
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource CaptionLineHeight}" />
        <Setter Property="FontWeight" Value="{StaticResource CaptionFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
</ResourceDictionary>
