<Application x:Class="Brady.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Order matters: later dictionaries use StaticResource from earlier ones.
                 ThemeManager appends the light/dark color dictionary at startup. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.Metrics.xaml" />
                <ResourceDictionary Source="Theme/Mascot.xaml" />
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/Typography.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
