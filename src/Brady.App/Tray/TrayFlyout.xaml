<!--
    The small glass panel that opens from a left click on the tray icon: what's coming up, a way to
    take a break right now, and pause or resume. It closes as soon as it loses focus.
-->
<Window x:Class="Brady.App.Tray.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Brady.App.Controls"
        Title="Brady"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Animated">

    <!-- The 64px margin is room for the shadow (12px offset plus its blur). -->
    <Grid x:Name="Root" Margin="64" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Rise" />
        </Grid.RenderTransform>

        <c:GlassSurface Width="320" Padding="20">
            <StackPanel>
                <DockPanel>
                    <Image x:Name="Head" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Brady" Style="{StaticResource TitleText}" />
                        <TextBlock x:Name="Status" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16,0,12" />

                <TextBlock Text="Coming up" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                <ItemsControl x:Name="Upcoming" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Height="32">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource BodyText}"
                                           Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                <c:Chip Kind="{Binding Kind}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="Empty" Style="{StaticResource BodyText}" Foreground="{DynamicResource InkMutedBrush}"
                           Text="All reminders are off." Visibility="Collapsed" Margin="0,6,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <c:BradyButton x:Name="BreakButton" Variant="Primary" Content="Take a break now" Click="OnBreakClick" />
                    <c:BradyButton x:Name="PauseButton" Variant="Glass" Margin="8,0,0,0" Content="Pause 30 min" Click="OnPauseClick" />
                </StackPanel>
            </StackPanel>
        </c:GlassSurface>
    </Grid>
</Window>
