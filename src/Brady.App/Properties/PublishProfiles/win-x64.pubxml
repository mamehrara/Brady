<?xml version="1.0" encoding="utf-8"?>
<!--
    The installer build: self-contained win-x64, so Brady runs on a PC without the .NET Desktop
    Runtime. One Brady.exe with the managed code bundled; WPF's few native DLLs sit beside it
    (no extraction to %TEMP% at startup). ReadyToRun keeps the first toast free of JIT pauses.
    Used by build/build-installer.ps1:  dotnet publish src/Brady.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\</PublishDir>
  </PropertyGroup>
</Project>
